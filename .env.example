# Copy this file to .env when you need local environment overrides.
# The default development setup uses the on-premise MySQL database.

FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN_ALT=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=
SERVER_API_BASE_URL=http://api:8080
FRONTEND_HOST_PORT=8091
API_HOST_PORT=5274

MYSQL_CONNECTION_STRING=Server=127.0.0.1;Port=3306;User ID=root;Password=YOUR_PASSWORD;Database=yanmarassy;SslMode=None;AllowPublicKeyRetrieval=True;

JWT_ISSUER=AssemblySystem
JWT_AUDIENCE=AssemblySystem.Frontend
JWT_SIGNING_KEY=replace-with-a-long-random-assembly-secret
JWT_EXPIRES_HOURS=8

SWAGGER_ENABLED=true

MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_CLIENT_ID=AssemblyNutRunnerWorker
MQTT_TOPIC=assembly_nutrunner_mqtt
MQTT_QOS=2
MQTT_USERNAME=
MQTT_PASSWORD=
WORKER_INTERVAL_SECONDS=1
WORKER_RECONNECT_DELAY_SECONDS=3
